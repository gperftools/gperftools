# -*- Mode: python; -*-
# Offline perf.data DWARF-callchain converter. Uses aw-backtrace's fast-path
# CFI decoder (//:aw-fastpath) but links none of the in-process unwinder.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

COPTS = [
    "-Wall",
    "-Wextra",
    "-Wsign-compare",
]

PLATFORM = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

cc_library(
    name = "interval-map",
    hdrs = ["interval-map.h"],
    copts = COPTS,
)

cc_test(
    name = "interval-map-test",
    srcs = ["interval-map-test.cc"],
    copts = COPTS,
    deps = [
        ":interval-map",
        "@googletest//:gtest_main",
    ],
)

# mmap + ELF program-header parsing only, no CFI decoding of its own -- so,
# unlike perf-convert-lib, it carries no target_compatible_with and can be
# depended on from an aarch64 target too (see :frame-info-dump).
cc_library(
    name = "elf-module",
    srcs = ["elf-module.cc"],
    hdrs = ["elf-module.h"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:absl_check",
    ],
)

cc_library(
    name = "perf-convert-lib",
    srcs = [
        "perf-data.cc",
        "perf-writer.cc",
        "process-table.cc",
        "sample-dump.cc",
        "unwinder.cc",
    ],
    hdrs = [
        "perf-data.h",
        "perf-format.h",
        "perf-writer.h",
        "process-table.h",
        "sample-dump.h",
        "unwinder.h",
    ],
    copts = COPTS,
    target_compatible_with = PLATFORM,
    deps = [
        ":elf-module",
        ":interval-map",
        "//:aw-fastpath",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_binary(
    name = "perf-convert",
    srcs = ["perf-convert.cc"],
    copts = COPTS,
    target_compatible_with = PLATFORM,
    visibility = ["//visibility:public"],
    deps = [
        ":perf-convert-lib",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:absl_check",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "perf-convert-test",
    srcs = ["perf-convert-test.cc"],
    copts = COPTS,
    # SelfTest.SweepOwnFDEs sweeps this binary's own .eh_frame, so it must
    # be a self-contained ELF -- no split .so for the deps.
    linkstatic = True,
    target_compatible_with = PLATFORM,
    deps = [
        ":perf-convert-lib",
        "//:aw-fastpath",
        "@googletest//:gtest_main",
    ],
)

# Debugging aid: given an ELF module and a link-time vaddr in it, prints the
# FrameInfo the fast path and/or the full CFI decoder derive there, with no
# live process needed. Deliberately not target_compatible_with x86_64 only --
# :elf-module, //:aw-fastpath and //:aw-backtrace are all arch-neutral, and
# this is the tool meant for aarch64 unwind-info debugging.
cc_binary(
    name = "frame-info-dump",
    srcs = ["frame-info-dump.cc"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":elf-module",
        "//:aw-backtrace",
        "//:aw-fastpath",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings:str_format",
    ],
)
